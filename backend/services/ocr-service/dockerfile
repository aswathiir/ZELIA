FROM python:3.11-slim

# System deps for EasyOCR (OpenCV, libGL) and psycopg2
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 libsm6 libxrender1 libxext6 \
    libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps (torch CPU first for smaller image)
COPY requirements.txt .
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu \
    torch torchvision \
    && pip install --no-cache-dir -r requirements.txt

COPY . .

# Pre-download EasyOCR models on build (optional — speeds up first request)
RUN python -c "import easyocr; easyocr.Reader(['en'], gpu=False, model_storage_directory='/tmp/easyocr_models')" || true

EXPOSE 8003

CMD ["uvicorn", "ocr_service:app", "--host", "0.0.0.0", "--port", "8003"]