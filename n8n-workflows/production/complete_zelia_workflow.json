                ],
                [
                    {
                        "node": "Create Manual Review Submission",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Check Eligibility (Auto)": {
            "main": [
                [
                    {
                        "node": "Create Auto Submission",
