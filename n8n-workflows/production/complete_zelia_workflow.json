                        "index": 0
                    }
                ]
            ]
        },
        "LayoutLM Field Detection": {
            "main": [
                [
                    {
                        "node": "Extract Canonical Fields",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Extract Canonical Fields": {
            "main": [
                [
                    {
                        "node": "High Confidence?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Web Scraper Search": {
            "main": [
                [
                    {
                        "node": "Merge & Rank Schemes",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "RAG Hybrid Search": {
            "main": [
                [
                    {
                        "node": "Merge & Rank Schemes",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Merge & Rank Schemes": {
            "main": [
                [
                    {
                        "node": "Extract Scheme Metadata",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Extract Scheme Metadata": {
            "main": [
                [
                    {
                        "node": "Translate Scheme Titles",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Translate Scheme Titles": {
            "main": [
                [
                    {
                        "node": "Build Final Response",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "High Confidence?": {
            "main": [
                [
                    {
                        "node": "Check Eligibility (Auto)",
                        "type": "main",
