{
  "name": "ZELIA Voice Query - Working v2",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "voice-query",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-start",
      "name": "Voice Query Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [220, 300],
      "webhookId": "zelia-voice"
    },
    {
      "parameters": {
        "jsCode": "// Extract voice query data\nconst body = $input.item.json.body || $input.item.json;\n\nconst transcript = body.transcript || body.query || '';\nconst language = body.language || 'ta-IN';\nconst queryType = body.query_type || body.queryType || 'scheme_search';\nconst entities = body.extracted_entities || body.entities || {};\n\nif (!transcript) {\n  throw new Error('Missing transcript');\n}\n\nreturn {\n  transcript: transcript,\n  language: language,\n  query_type: queryType,\n  entities: entities,\n  timestamp: new Date().toISOString()\n};"
      },
      "id": "extract-input",
      "name": "Extract Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "url": "=http://translation-service:8009/translate",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"{{ $json.transcript }}\",\n  \"source_lang\": \"{{ $json.language }}\",\n  \"target_lang\": \"en-IN\"\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "translate-query",
      "name": "Translate to English",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [620, 300]
    },
    {
      "parameters": {
        "url": "=http://web-scraper:8008/search?query={{ encodeURIComponent($json.translated_text || $('extract-input').item.json.transcript) }}&limit=5",
        "method": "GET",
        "options": {
          "timeout": 10000
        }
      },
      "id": "search-schemes",
      "name": "Search Schemes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [820, 300]
    },
    {
      "parameters": {
        "jsCode": "// Format response\nconst searchResult = $input.item.json;\nconst originalLang = $('extract-input').item.json.language;\nconst transcript = $('extract-input').item.json.transcript;\n\nconst schemes = searchResult.schemes || [];\n\n// Create English response\nlet responseText = '';\nif (schemes.length === 0) {\n  responseText = 'I could not find any schemes matching your query. Please try rephrasing or contact a Community Health Worker for assistance.';\n} else {\n  const topSchemes = schemes.slice(0, 3).map(s => s.title).join(', ');\n  responseText = `I found ${schemes.length} schemes that may help you. The top matches are: ${topSchemes}.`;\n  if (schemes.length > 3) {\n    responseText += ` There are ${schemes.length - 3} more schemes available.`;\n  }\n  responseText += ' Would you like more details about any specific scheme?';\n}\n\nreturn {\n  response_text: responseText,\n  schemes: schemes,\n  language: originalLang,\n  original_query: transcript,\n  needs_translation: originalLang !== 'en-IN'\n};"
      },
      "id": "format-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1020, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "needs-translation",
              "leftValue": "={{ $json.needs_translation }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-translation-needed",
      "name": "Translation Needed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1220, 300]
    },
    {
      "parameters": {
        "url": "=http://translation-service:8009/translate",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"{{ $json.response_text }}\",\n  \"source_lang\": \"en-IN\",\n  \"target_lang\": \"{{ $json.language }}\"\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "translate-response",
      "name": "Translate Response",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1420, 200]
    },
    {
      "parameters": {
        "jsCode": "// Combine translated response with schemes\nconst formatData = $('format-response').item.json;\nconst translatedText = $input.item.json.translated_text || formatData.response_text;\n\nreturn {\n  success: true,\n  language: formatData.language,\n  response: translatedText,\n  schemes: formatData.schemes,\n  original_query: formatData.original_query,\n  timestamp: new Date().toISOString()\n};"
      },
      "id": "final-response-translated",
      "name": "Final Response (Translated)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1620, 200]
    },
    {
      "parameters": {
        "jsCode": "// Use English response directly\nconst formatData = $input.item.json;\n\nreturn {\n  success: true,\n  language: formatData.language,\n  response: formatData.response_text,\n  schemes: formatData.schemes,\n  original_query: formatData.original_query,\n  timestamp: new Date().toISOString()\n};"
      },
      "id": "final-response-english",
      "name": "Final Response (English)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1620, 400]
    },
    {
      "parameters": {
        "respondWith": "allIncomingItems",
        "options": {}
      },
      "id": "respond-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1820, 300]
    }
  ],
  "connections": {
    "Voice Query Webhook": {
      "main": [[{"node": "Extract Input", "type": "main", "index": 0}]]
    },
    "Extract Input": {
      "main": [[{"node": "Translate to English", "type": "main", "index": 0}]]
    },
    "Translate to English": {
      "main": [[{"node": "Search Schemes", "type": "main", "index": 0}]]
    },
    "Search Schemes": {
      "main": [[{"node": "Format Response", "type": "main", "index": 0}]]
    },
    "Format Response": {
      "main": [[{"node": "Translation Needed?", "type": "main", "index": 0}]]
    },
    "Translation Needed?": {
      "main": [
        [{"node": "Translate Response", "type": "main", "index": 0}],
        [{"node": "Final Response (English)", "type": "main", "index": 0}]
      ]
    },
    "Translate Response": {
      "main": [[{"node": "Final Response (Translated)", "type": "main", "index": 0}]]
    },
    "Final Response (Translated)": {
      "main": [[{"node": "Respond to Webhook", "type": "main", "index": 0}]]
    },
    "Final Response (English)": {
      "main": [[{"node": "Respond to Webhook", "type": "main", "index": 0}]]
    }
  },
